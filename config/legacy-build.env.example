#!/usr/bin/env bash

# Copy this file outside the repository, replace the placeholder paths, and
# source it before configuring an optional CMake SDK build. Do not commit a local
# copy containing workstation-specific paths.

export MAYA_LOCATION="/path/to/Autodesk/maya2019"
export MAYA_DEVKIT_LOCATION="/path/to/maya2019-devkit"
export ARNOLD_SDK_LOCATION="/path/to/arnold-sdk"
export MTOA_LOCATION="/path/to/mtoa/2019"

# Prefix that contains include/, lib/, and (when needed) Frameworks/.
export DOMMY_DEPENDENCY_PREFIX="/path/to/dommy-dependencies"

# Separate prefix for locally built legacy libraries such as SeExpr.
export DOMMY_LEGACY_PREFIX="/path/to/dommy-legacy-dependencies"

# Optional override. Audit scripts use the checksum-pinned nanoflann 1.2.3
# source automatically when this is unset.
export NANOFLANN_LOCATION="/path/to/nanoflann"
# Optional; required only with DOMMY_ENABLE_FREETYPE_TEXT_NODE=ON.
export FREETYPE_LOCATION="/path/to/freetype"
export JET_LOCATION="/path/to/jet"

# Optional; required only with DOMMY_ENABLE_FASTNOISE_NODES=ON. The historical
# integration compiles FastNoise.cpp directly, but its exact revision is unknown.
export FASTNOISE_LOCATION="/path/to/FastNoise"

# For the CMake package target, pass the Maya modules directory as the install
# prefix (for example: cmake --install build-maya2019 --prefix "$MAYA_MODULES_DIR").
export MAYA_MODULES_DIR="/path/to/maya/modules"
