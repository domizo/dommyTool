# Use this file as a template and export the variables in your shell or launcher.
# Never commit real credentials.
# SMTP is opt-in and requires verified TLS plus a usable trusted CA store.

DOMMYTOOL_SMTP_USER=
DOMMYTOOL_SMTP_PASSWORD=
DOMMYTOOL_SMTP_HOST=smtp.gmail.com
DOMMYTOOL_SMTP_PORT=465

# Optional local paths
DOMMY_PROJECT_ROOT=
DOMMYTOOL_USER_LIST=
